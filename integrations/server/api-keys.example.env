# Заполняемый файл: private/api-keys.env. Здесь настоящих ключей быть не должно.
OPENAI_API_KEY=
YOUTUBE_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# ТОЛЬКО запросы API нашего лаунчера. Не VPN, не трафик приложений.
# direct = ТВ -> API поставщика через текущее домашнее соединение, своего IP не надо.
# ru = ТВ -> наш API-сервис RU -> API поставщика.
# us = ТВ -> наш API-сервис RU -> обработчик US -> API поставщика.
# IP ниже относятся только к режимам ru/us; для direct не используются.
API_RU_RELAY_IP=188.120.240.175
API_US_WORKER_IP=40.160.252.24
OPENAI_API_ROUTE=us
YOUTUBE_DATA_API_ROUTE=us
GOOGLE_OAUTH_API_ROUTE=us
TMDB_API_ROUTE=ru
TMDB_API_FALLBACK_ROUTE=us
OPEN_METEO_API_ROUTE=ru
WTTR_API_ROUTE=direct
# Резерв того же поставщика при сбое прямого обращения.
WTTR_API_FALLBACK_ROUTE=ru
CBR_API_ROUTE=direct
COINBASE_API_ROUTE=direct

# Бесплатные источники, ключ не нужен. Порядок — приоритет и резерв.
WEATHER_PROVIDERS=open_meteo,wttr
WEATHER_CACHE_SECONDS=1800
# Google OAuth JSON: private/oauth-client.json. Токены выдаются после входа.

# Default-deny: this workspace also contains firmware dumps and personal diagnostics.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CHANGELOG.md
!/ROADMAP.md
!/docs/
!/site/
!/.github/
!/tests/
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.swift
!/builds/
/builds/*
!/builds/proskurnin-preview-v1/
!/builds/proskurnin-remote-v1/
!/builds/proskurnin-home-router/
!/builds/proskurnin-power-menu/
!/builds/proskurnin-power-focus/
/builds/*/*
!/builds/proskurnin-preview-v1/app/
!/builds/proskurnin-remote-v1/app/
!/builds/proskurnin-remote-v1/bridge/
!/builds/proskurnin-remote-v1/proskurnin_remote.rc
!/builds/proskurnin-home-router/app/
!/builds/proskurnin-power-menu/res/
!/builds/proskurnin-power-focus/res/
!/builds/proskurnin-power-focus/AndroidManifest.xml
!/integrations/
/integrations/*
!/integrations/server/
/integrations/server/*
!/integrations/server/*.py
!/integrations/server/*.txt
!/integrations/server/*.example.json
!/integrations/server/*.example.env
# Never publish credentials, generated binaries, caches or local test captures.
**/private/
**/__pycache__/
**/.DS_Store
**/*.pyc
**/*.class
**/*.dex
**/*.apk
**/*.idsig
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*.key
**/api-keys.env
**/oauth-*.json
**/api-client.json
!/builds/proskurnin-power-menu/AndroidManifest.xml
!/.gitattributes

!/builds/proskurnin-power-actions/
!/builds/proskurnin-power-actions/src/
!/builds/proskurnin-power-actions/proskurnin_power.rc

!/builds/proskurnin-stats/
!/builds/proskurnin-stats/src/
